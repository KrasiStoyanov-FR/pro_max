# ============================================
# Environment Variables Configuration
# ============================================
# Copy this file to .env.local for local development
# or .env.production for production deployment
# ============================================

# Testing/Development Configuration
# Set to 'true' to enable test mode (shows all data regardless of age)
# When enabled, time windows are extended to 1 year for testing purposes
# Default: 'false' (production mode with 15-minute window)
VITE_TEST_MODE=false

# Time Window Configuration (in milliseconds)
# These values are used in production mode. In test mode, they are overridden to 1 year.
# Active drone position window - how recent a position must be to consider drone active
# Default: 900000 (15 minutes)
VITE_ACTIVE_POSITION_WINDOW_MS=900000

# RF detection window - how recent a detection must be to count as active
# Default: 3600000 (1 hour)
VITE_DETECTION_WINDOW_MS=3600000

# Maximum position age when drone has recent detections
# Default: 3600000 (1 hour)
VITE_MAX_POSITION_AGE_MS=3600000

# ============================================
# Frontend Configuration (Vite)
# ============================================

# API Configuration
# Backend API base URL - used by frontend to connect to backend
# Examples:
#   Local: http://localhost:3001/api/db
#   Remote: http://172.16.50.50:3001/api/db
#   Production: https://dds.pm99.site:3001/api/db
VITE_API_BASE_URL=http://localhost:3001/api/db

# SSE endpoint - can be different (optional)
# If you want to test SSE on localhost, uncomment this:
#   Local: http://localhost:3001/api/db
VITE_SSE_BASE_URL=http://localhost:3001/api/db
# Otherwise, SSE will use the same URL as VITE_API_BASE_URL

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=30000

# Brand Configuration
# Set to 'original' or 'pakistan' to switch between brand variants
# Default: 'original'
VITE_APP_BRAND=pakistan

# Database name to use in API requests
# This should match the database name configured in the backend
VITE_DB_NAME=drone_monitoring

# Development Server Configuration
# Frontend development server port
VITE_PORT=3000

# Frontend development server host
# Set to 'true' to allow external connections, 'false' for localhost only
VITE_HOST=true

# Comma-separated list of allowed hosts for development server
# Examples:
#   Local: dds.pm99.site or localhost
#   Remote: 127.0.0.1
VITE_ALLOWED_HOSTS=dds.pm99.site

# Map Configuration
# Map provider: 'leaflet' or 'mapbox'
VITE_MAP_PROVIDER=leaflet

# Mapbox API key (required only if using Mapbox)
VITE_MAPBOX_KEY=your_mapbox_key_here

# Application Title
VITE_APP_TITLE=Drone Tracking System

# ============================================
# Backend Configuration (Node.js/Express)
# ============================================

# Server Port
# Port on which the backend server will listen
PORT=3001

# Alternative server port variable (for compatibility)
SERVER_PORT=3001

# Server Host
# Hostname or IP address for server logs and health check URLs
# Default: localhost
SERVER_HOST=localhost

# ============================================
# Database Configuration
# ============================================

# Database Type
# Set to 'true' for local testing with SQLite, 'false' or unset to use MariaDB/MySQL
USE_SQLITE=

# SQLite Database Path (only used if USE_SQLITE=true)
# Relative path or absolute path to SQLite database file
SQLITE_PATH=database.sqlite

# MariaDB/MySQL Configuration (used when USE_SQLITE=false)
# Database host address
# Examples:
#   Local: localhost or dds.pm99.site
#   Remote: 172.16.50.100
DB_HOST=172.16.50.100

# Database port
# Examples: 
#   Local: 58591 for custom port
#   Remote: 3306 for MySQL/MariaDB
DB_PORT=3306

# Database username
DB_USER=drone_app

# Database password
# IMPORTANT: Never commit passwords to version control!
# Use environment-specific .env files or secrets management
DB_PASSWORD=Qwerty@

# Database name
DB_NAME=drone_monitoring

# Connection Pool Configuration
# Maximum number of connections in the pool
DB_CONNECTION_LIMIT=10

# Maximum time to wait for a connection from the pool (milliseconds)
DB_ACQUIRE_TIMEOUT=60000

# Query timeout (milliseconds)
DB_TIMEOUT=60000

# Connection timeout (milliseconds)
DB_CONNECT_TIMEOUT=10000

# Enable automatic reconnection on connection loss
# Set to 'false' to disable automatic reconnection
DB_RECONNECT=true

# Database character set
DB_CHARSET=utf8mb4  


# ============================================
# Live View Performance Settings
# ============================================

# Which sensor to fly around (default DDS93)
PERF_SENSOR_SYSTEM_ID=DDS63
VITE_PERF_SENSOR_SYSTEM_ID=DDS63
# Numeric drone ID (default 9999)
PERF_DRONE_ID=7601
VITE_PERF_DRONE_ID=7601
# Number of waypoints (default 30)
PERF_FLIGHT_POINTS=30
VITE_PERF_FLIGHT_POINTS=30
# Radius around sensor in km (default 0.8)
PERF_FLIGHT_RADIUS_KM=0.8
VITE_PERF_FLIGHT_RADIUS_KM=0.8

# ============================================
# Production Deployment Examples
# ============================================
#
# For remote server deployment, you might use:
#
# VITE_API_BASE_URL=http://dds.pm99.site:3001/api/db
# DB_HOST=dds.pm99.site
# DB_PORT=58591
# DB_USER=drone_app
# DB_PASSWORD=your_secure_password_here
# DB_NAME=drone_monitoring
#
# ============================================
