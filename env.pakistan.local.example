# ============================================
# Pakistan Local Deployment Configuration
# ============================================
# This configuration is for Pakistan client's LOCAL deployment
# Uses SQLite database (local file) instead of remote MariaDB/MySQL
# ============================================
# Copy this file to .env for local deployment
# ============================================

# ============================================
# Frontend Configuration (Vite)
# ============================================

# API Configuration
# Backend API base URL - use localhost for local deployment
# For network access, replace localhost with your machine's IP address
# Examples:
#   Local only: http://localhost:3001/api/db
#   Network access: http://192.168.1.100:3001/api/db
#   Custom domain: http://your-domain.local:3001/api/db
VITE_API_BASE_URL=http://localhost:3001/api/db

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=30000

# Database name to use in API requests
# Note: For SQLite, this is just a label - actual data is in the SQLite file
VITE_DB_NAME=drone_monitoring

# Development Server Configuration
# Frontend development server port
VITE_PORT=3000

# Frontend development server host
# Set to 'true' to allow external connections (for IP address and URL access)
# Set to 'false' for localhost only
VITE_HOST=true

# Comma-separated list of allowed hosts for development server
# Add your machine's IP address and any custom domains here
# Example: 192.168.1.100,localhost,127.0.0.1,your-domain.local
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Map Configuration
# Map provider: 'leaflet' or 'mapbox'
VITE_MAP_PROVIDER=leaflet

# Mapbox API key (required only if using Mapbox)
VITE_MAPBOX_KEY=your_mapbox_key_here

# Application Title
VITE_APP_TITLE=Defense Radar Dashboard

# Brand Configuration
# Set to 'pakistan' for Pakistan brand
VITE_APP_BRAND=pakistan

# ============================================
# Backend Configuration (Node.js/Express)
# ============================================

# Server Port
# Port on which the backend server will listen
PORT=3001

# Alternative server port variable (for compatibility)
SERVER_PORT=3001

# Server Host
# Hostname or IP address for server logs and health check URLs
# Use '0.0.0.0' to listen on all network interfaces (for IP/URL access)
# Use 'localhost' for localhost only
SERVER_HOST=0.0.0.0

# ============================================
# Database Configuration - SQLite (LOCAL)
# ============================================
# IMPORTANT: This configuration uses SQLite, a local file-based database
# No remote database server is required!
# ============================================

# Database Type
# Set to 'true' to use SQLite (local file database)
# Set to 'false' to use MariaDB/MySQL (remote database)
USE_SQLITE=true

# SQLite Database Path
# Path to the SQLite database file
# Can be relative (from project root) or absolute
# Default: database.sqlite in project root
# Examples:
#   Relative: database.sqlite
#   Absolute: /path/to/database.sqlite
#   Custom location: ./data/database.sqlite
SQLITE_PATH=database.sqlite

# ============================================
# MariaDB/MySQL Configuration (NOT USED when USE_SQLITE=true)
# ============================================
# These settings are ignored when USE_SQLITE=true
# They are kept here for reference only
# ============================================

# Database host address (not used with SQLite)
DB_HOST=localhost

# Database port (not used with SQLite)
DB_PORT=3306

# Database username (not used with SQLite)
DB_USER=root

# Database password (not used with SQLite)
DB_PASSWORD=

# Database name (not used with SQLite)
DB_NAME=drone_monitoring

# Connection Pool Configuration (not used with SQLite)
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000
DB_CONNECT_TIMEOUT=10000
DB_RECONNECT=true
DB_CHARSET=utf8mb4

# ============================================
# Network Access Configuration
# ============================================
# To access the application via IP address or URL:
#
# 1. Find your machine's IP address:
#    Windows: ipconfig
#    Linux/Mac: ifconfig or ip addr
#
# 2. Update VITE_API_BASE_URL with your IP:
#    VITE_API_BASE_URL=http://YOUR_IP:3001/api/db
#
# 3. Update VITE_ALLOWED_HOSTS with your IP:
#    VITE_ALLOWED_HOSTS=YOUR_IP,localhost,127.0.0.1
#
# 4. Ensure firewall allows connections on ports 3000 and 3001
#
# Example for IP 192.168.1.100:
# VITE_API_BASE_URL=http://192.168.1.100:3001/api/db
# VITE_ALLOWED_HOSTS=192.168.1.100,localhost,127.0.0.1
# ============================================
