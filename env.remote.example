# ============================================
# Remote Access Configuration Template
# For accessing application at http://10.80.10.223:3000
# ============================================
# Copy this file to .env on the server
# ============================================

# ============================================
# Frontend Configuration (Vite)
# ============================================

# API Configuration
# Backend API base URL - MUST use server IP for remote access
# Frontend (browser) will connect to backend using this URL
VITE_API_BASE_URL=http://10.80.10.223:3001/api/db

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=30000

# Database name to use in API requests
VITE_DB_NAME=drone_monitoring

# Development Server Configuration
# Frontend development server port
VITE_PORT=3000

# Frontend development server host
# Set to 'true' to allow external connections
VITE_HOST=true

# Comma-separated list of allowed hosts for development server
# Include server IP and any other hosts that will access the app
VITE_ALLOWED_HOSTS=10.80.10.223,localhost,127.0.0.1

# Map Configuration
VITE_MAP_PROVIDER=leaflet
VITE_MAPBOX_KEY=your_mapbox_key_here

# Application Title
VITE_APP_TITLE=Defense Radar Dashboard

# ============================================
# Backend Configuration (Node.js/Express)
# ============================================

# Server Port
# Port on which the backend server will listen
PORT=3001

# Alternative server port variable (for compatibility)
SERVER_PORT=3001

# Server Host
# IP address for server logs and health check URLs
# Use server IP for remote access
SERVER_HOST=10.80.10.223

# ============================================
# Database Configuration
# ============================================
# IMPORTANT: Database is LOCAL on the server
# Use localhost even when accessing app remotely
# ============================================

# Database Type
# Set to 'true' to use SQLite, 'false' to use MariaDB/MySQL
USE_SQLITE=false

# SQLite Database Path (only used if USE_SQLITE=true)
SQLITE_PATH=database.sqlite

# MariaDB/MySQL Configuration
# Database host - ALWAYS use localhost since DB is on the same server
DB_HOST=localhost

# Database port
# Default: 3306 for MySQL/MariaDB
# If your database uses a different port, change it here
DB_PORT=3306

# Database username
DB_USER=drone_app

# Database password
DB_PASSWORD=Qwerty@

# Database name
DB_NAME=drone_monitoring

# Connection Pool Configuration
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000
DB_CONNECT_TIMEOUT=10000
DB_RECONNECT=true
DB_CHARSET=utf8mb4




